# M7 真实档评测 env 模板（issue 07 / D-66·D-67）：复制为 .env 后填入真实 key。
# .env 已 gitignore（key 不落库不入 git）；单价为 ¥/M tokens，随平台牌价更新。

# ── 被评模型 profile（kimi-k2.6 质量上探 / kimi-k2.5 性价比基线，2026-09 拍板）──
ONCALL_LLM_PROFILE_K2_6_BASE_URL=https://api.moonshot.cn/v1
ONCALL_LLM_PROFILE_K2_6_MODEL=kimi-k2.6
ONCALL_LLM_PROFILE_K2_6_API_KEY=sk-xxx
# ¥/M tokens（kimi-k2.6 牌价 2026-09：输入 6.5 / 输出 27）
ONCALL_LLM_PROFILE_K2_6_PRICE_IN=6.5
ONCALL_LLM_PROFILE_K2_6_PRICE_OUT=27

ONCALL_LLM_PROFILE_K2_5_BASE_URL=https://api.moonshot.cn/v1
ONCALL_LLM_PROFILE_K2_5_MODEL=kimi-k2.5
ONCALL_LLM_PROFILE_K2_5_API_KEY=sk-xxx
# ¥/M tokens（kimi-k2.5 牌价 2026-09：输入 4 / 输出 21）
ONCALL_LLM_PROFILE_K2_5_PRICE_IN=4
ONCALL_LLM_PROFILE_K2_5_PRICE_OUT=21

# ── LLM-as-judge（防自评：独立前缀，禁复用被评模型 profile）──
ONCALL_JUDGE_LLM_BASE_URL=https://api.moonshot.cn/v1
ONCALL_JUDGE_LLM_MODEL=moonshot-v1-8k
ONCALL_JUDGE_LLM_API_KEY=sk-xxx
# ¥/M tokens（moonshot-v1-8k 牌价 2026-09：输入 2 / 输出 10）
ONCALL_JUDGE_LLM_PRICE_IN=2
ONCALL_JUDGE_LLM_PRICE_OUT=10
