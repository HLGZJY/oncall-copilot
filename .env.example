# M7 真实档评测 env 模板（issue 07 / D-66·D-67）：复制为 .env 后填入真实 key。
# .env 已 gitignore（key 不落库不入 git）；单价为 ¥/M tokens，随平台牌价更新。
# profile 名连字符/下划线等价（K2-6 ≡ K2_6）。

# ── 被评模型 profile（kimi-k2.6 性价比基线 / kimi-k3 旗舰质量上探，2026-09-09 复核拍板：
#    原 k2.5 与 moonshot-v1 系列已从现役模型列表下架，key 实测 /models 仅 4 个现役档）──
ONCALL_LLM_PROFILE_K2_6_BASE_URL=https://api.moonshot.cn/v1
ONCALL_LLM_PROFILE_K2_6_MODEL=kimi-k2.6
ONCALL_LLM_PROFILE_K2_6_API_KEY=sk-xxx
# ¥/M tokens（kimi-k2.6 牌价 2026-09：输入 6.5 / 输出 27，缓存未命中口径）
ONCALL_LLM_PROFILE_K2_6_PRICE_IN=6.5
ONCALL_LLM_PROFILE_K2_6_PRICE_OUT=27

ONCALL_LLM_PROFILE_K3_BASE_URL=https://api.moonshot.cn/v1
ONCALL_LLM_PROFILE_K3_MODEL=kimi-k3
ONCALL_LLM_PROFILE_K3_API_KEY=sk-xxx
# ¥/M tokens（kimi-k3 牌价 2026-09：输入 20 / 输出 100，强制思考输出偏高）
ONCALL_LLM_PROFILE_K3_PRICE_IN=20
ONCALL_LLM_PROFILE_K3_PRICE_OUT=100

# ── LLM-as-judge（防自评：独立前缀，禁复用被评模型 profile；现役选 kimi-k2.7-code）──
ONCALL_JUDGE_LLM_BASE_URL=https://api.moonshot.cn/v1
ONCALL_JUDGE_LLM_MODEL=kimi-k2.7-code
ONCALL_JUDGE_LLM_API_KEY=sk-xxx
# ¥/M tokens（kimi-k2.7-code 牌价 2026-09：输入 6.5 / 输出 27）
ONCALL_JUDGE_LLM_PRICE_IN=6.5
ONCALL_JUDGE_LLM_PRICE_OUT=27
